# ------------------------------------------------------------------
# CONFIGURATION DEVELOPPEMENT UNIQUEMENT
# NE PAS UTILISER CES VALEURS EN PRODUCTION
# Copiez ce fichier en .env pour l'utiliser avec docker compose
# ------------------------------------------------------------------

# Base de données Keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# Base de données applicative (utilisée aussi par le backend)
APP_DB=financeapp
APP_DB_USER=financeapp
APP_DB_PASSWORD=financeapp

# Keycloak admin (compte bootstrap, realm master)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Origine autorisée par CORS pour le backend (frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Clés d'API externes, obligatoires : docker compose refuse de démarrer si elles sont vides.
# FMP (données de marché) : https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# Gemini (module IA) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chemins des dépôts backend et frontend, relatifs à ce dossier.
# À définir seulement si vos dossiers ne portent pas le nom des dépôts GitHub
# (finance-app-backend et frontend-financeHub) :
# BACKEND_PATH=../Back
# FRONTEND_PATH=../Front
