# ------------------------------------------------------------------
# CONFIGURATION DEVELOPPEMENT UNIQUEMENT
# NE PAS UTILISER CES VALEURS EN PRODUCTION
# Copiez ce fichier en .env pour l'utiliser avec docker compose
# ------------------------------------------------------------------

# Base de données Keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak

# Base de données applicative (utilisée aussi par le backend)
APP_DB=financeapp
APP_DB_USER=financeapp
APP_DB_PASSWORD=financeapp

# Keycloak admin (compte bootstrap, realm master)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Origine autorisée par CORS pour le backend (frontend Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Clé d'API externe requise : docker compose refuse de démarrer si elle est vide.
# FMP (données de marché) : https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# Mode de synthèse : stub par défaut, sans clé Gemini ni appel réseau.
INTELLIGENCE_AI_MODE=stub
# Pour le mode gemini, créer une clé Google AI Studio : https://aistudio.google.com/apikey
# Choisir un modèle Gemini actuellement disponible dans l'offre gratuite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
